DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dpo_api?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:8443,http://localhost:8080,http://127.0.0.1:8080"
PUBLIC_API_ORIGIN="http://localhost:3000"
MEDIA_DIRECTORY="./uploads"
# Defaults to MEDIA_DIRECTORY/geoip/country.mmdb (npm run geoip:update).
# Optionally override with a GeoLite2-Country or compatible MMDB file.
GEOIP_DATABASE_PATH=""
# For a verified proxy chain only. The final proxy must overwrite client headers.
TRUSTED_PROXY_CIDRS=""
# Enable only when the trusted proxy supplies/overwrites Cloudflare country headers.
ANALYTICS_COUNTRY_HEADER=""
# Optional stable HMAC secret; JWT_SECRET is used when this is empty.
ANALYTICS_HASH_SECRET=""
# Public website files are served from MEDIA_DIRECTORY/assets at /api/assets/.
# Admin uploads live in MEDIA_DIRECTORY/media; migration files live in migrations/.
# Persist this directory and copy its files when deploying (see ASSETS.md).
