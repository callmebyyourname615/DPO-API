generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum PublishStatus {
  draft
  published
}
enum NewsCategory {
  news
  activity
  announcement
  international
}
enum DocumentCategory {
  decree
  agreement
  notice
  form
  guideline
  fsnp
  general
}
enum FileStatus {
  available
  missing
  processing
}
enum FileType {
  pdf
  xlsx
}
enum InquiryStatus {
  new
  in_progress
  resolved
  archived
}
enum InquirySource {
  contact
  faq
}
enum UserRole {
  admin
  editor
  viewer
}
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(viewer)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model News {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  category      NewsCategory
  excerpt       String        @default("")
  content       String
  coverImageUrl String?
  gallery       String[]      @default([])
  publishedAt   DateTime?
  status        PublishStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([status, publishedAt])
  @@index([category, status])
}
model Document {
  id           String           @id @default(cuid())
  title        String
  category     DocumentCategory
  documentDate DateTime?
  fileUrl      String?
  fileName     String?
  fileType     FileType?
  fileSize     Int?
  fileStatus   FileStatus       @default(missing)
  status       PublishStatus    @default(draft)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([status, category])
}
model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String        @default("")
  message   String
  source    InquirySource @default(contact)
  status    InquiryStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, createdAt])
}
model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String
  order     Int           @default(0)
  status    PublishStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, order])
}
model Partner {
  id        String        @id @default(cuid())
  name      String
  logoUrl   String?
  address   String        @default("")
  phone     String        @default("")
  email     String        @default("")
  url       String
  order     Int           @default(0)
  status    PublishStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, order])
}
model Banner {
  id        String        @id @default(cuid())
  title     String
  imageUrl  String?
  linkUrl   String        @default("")
  order     Int           @default(0)
  status    PublishStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, order])
}
model Page {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  content   String
  imageUrl  String?
  status    PublishStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
model HomeIntro {
  id        String   @id @default("main")
  title     String   @default("")
  content   String   @default("")
  imageUrl  String?
  updatedAt DateTime @updatedAt
}
model SiteSettings {
  id             String   @id @default("main")
  email          String   @default("")
  phone          String   @default("")
  address        String   @default("")
  facebookUrl    String   @default("")
  youtubeUrl     String   @default("")
  mapEmbedUrl    String   @default("")
  footerAudioUrl String?
  footerAudioUrl2 String?
  updatedAt      DateTime @updatedAt
}
model Media {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorDaily {
  date   DateTime @id @db.Date
  visits Int      @default(0)
}
